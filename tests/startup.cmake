if(NOT DEFINED APP)
  message(FATAL_ERROR "APP must be supplied")
endif()
function(expect code pattern)
  execute_process(COMMAND "${APP}" ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  if(NOT "${result}" STREQUAL "${code}" OR NOT "${out}${err}" MATCHES "${pattern}")
    message(FATAL_ERROR "Unexpected result ${result}: ${out}${err}")
  endif()
endfunction()
expect(0 "face_detection" --help)
expect(1 "Unknown option" --unknown)
expect(1 "Threshold must" --threshold nan)
expect(1 "Cannot open model" --model "${CMAKE_CURRENT_BINARY_DIR}/nonexistent-face-model.onnx")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/invalid-face-model.onnx" "invalid ONNX")
expect(1 "Error:" --model "${CMAKE_CURRENT_BINARY_DIR}/invalid-face-model.onnx" --check-model)
file(REMOVE "${CMAKE_CURRENT_BINARY_DIR}/invalid-face-model.onnx")
